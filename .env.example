# Environment template (placeholder values)
COOLBITS_DATABASE_URL=postgresql://user:pass@host:5432/dbname
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_OAUTH_REDIRECT_BASE=https://example.com
APP_BASE_URL=https://coolbits.ai

# Contact form (Cloudflare Turnstile + SMTP)
# - Site key is public (served via GET /api/public/contact-config)
# - Secret key + SMTP creds must stay server-side
TURNSTILE_SITE_KEY=0xREPLACE_ME
TURNSTILE_SECRET_KEY=0xREPLACE_ME

CONTACT_RECIPIENT=office@coolbits.ai
CONTACT_FROM=no-reply@coolbits.ai
CONTACT_REPLY_TO=office@coolbits.ai

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_SECURE=false
